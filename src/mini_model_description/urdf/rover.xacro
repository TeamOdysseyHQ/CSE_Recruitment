<!-- ROS 2 Control Hardware Interface - Gazebo Classic -->
<ros2_control name="GazeboSystem" type="system">
  <hardware>
    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
  </hardware>

  <joint name="Revolute_25">
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="Revolute_26">
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="Revolute_32">
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="Revolute_33">
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="Revolute_29">
    <command_interface name="velocity">
      <param name="min">-50.0</param>
      <param name="max">50.0</param>
    </command_interface>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="Revolute_30">
    <command_interface name="velocity">
      <param name="min">-50.0</param>
      <param name="max">50.0</param>
    </command_interface>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="Revolute_31">
    <command_interface name="velocity">
      <param name="min">-50.0</param>
      <param name="max">50.0</param>
    </command_interface>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="Revolute_36">
    <command_interface name="velocity">
      <param name="min">-50.0</param>
      <param name="max">50.0</param>
    </command_interface>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="Revolute_37">
    <command_interface name="velocity">
      <param name="min">-50.0</param>
      <param name="max">50.0</param>
    </command_interface>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="Revolute_38">
    <command_interface name="velocity">
      <param name="min">-50.0</param>
      <param name="max">50.0</param>
    </command_interface>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
</ros2_control>

<!-- Gazebo Classic ros2_control plugin -->
<gazebo>
  <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
    <parameters>$(find mini_model_control)/config/rover_controllers.yaml</parameters>
    <robot_param_node>robot_state_publisher</robot_param_node>
  </plugin>
</gazebo>

</robot>