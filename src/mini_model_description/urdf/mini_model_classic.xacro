<?xml version="1.0" ?>
<robot name="mini_model" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find mini_model_description)/urdf/materials.xacro" />
<xacro:include filename="$(find mini_model_description)/urdf/mini_model.gazebo" />

<!-- ros2_control hardware interface for Gazebo Classic -->
<ros2_control name="GazeboSystem" type="system">
  <hardware>
    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
  </hardware>

  <!-- SUSPENSION JOINTS -->
  <joint name="Revolute 25">
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="Revolute 26">
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="Revolute 32">
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="Revolute 33">
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <!-- DRIVE JOINTS (velocity controlled) -->
  <joint name="Revolute 29">
    <command_interface name="velocity">
      <param name="min">-50.0</param>
      <param name="max">50.0</param>
    </command_interface>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="Revolute 30">
    <command_interface name="velocity">
      <param name="min">-50.0</param>
      <param name="max">50.0</param>
    </command_interface>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="Revolute 31">
    <command_interface name="velocity">
      <param name="min">-50.0</param>
      <param name="max">50.0</param>
    </command_interface>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="Revolute 36">
    <command_interface name="velocity">
      <param name="min">-50.0</param>
      <param name="max">50.0</param>
    </command_interface>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="Revolute 37">
    <command_interface name="velocity">
      <param name="min">-50.0</param>
      <param name="max">50.0</param>
    </command_interface>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="Revolute 38">
    <command_interface name="velocity">
      <param name="min">-50.0</param>
      <param name="max">50.0</param>
    </command_interface>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
</ros2_control>

<!-- Gazebo Classic ros2_control plugin -->
<gazebo>
  <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
    <parameters>$(find mini_model_control)/config/rover_controllers.yaml</parameters>
  </plugin>
</gazebo>

</robot>

