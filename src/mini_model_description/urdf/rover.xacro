<?xml version="1.0" ?>
<robot name="mini_model" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Materials -->
<xacro:include filename="$(find mini_model_description)/urdf/materials.xacro" />

<!-- Gazebo Classic material/friction properties -->
<xacro:include filename="$(find mini_model_description)/urdf/mini_model.gazebo" />

<!-- NOTE: sensors.xacro and sensors.gazebo excluded -->
<!-- They use Ignition Fortress plugins incompatible with Gazebo Classic 11 -->
<link name="base_footprint"/>

<joint name="base_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0 0 0.15" rpy="1.5708 0 0"/>
</joint>

